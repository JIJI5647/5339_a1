# Copy this file to .env and fill in your own values.
# NEVER commit .env — it is already listed in .gitignore.

# Transport for NSW Open Data API key (requires a free account).
# Only needed if Task 1 retrieves from opendata.transport.nsw.gov.au
# instead of the data.gov.au mirror.
TFNSW_API_KEY=

# Only needed if used as the Task 3 augmentation source.
OCM_API_KEY=
GOOGLE_MAPS_API_KEY=
