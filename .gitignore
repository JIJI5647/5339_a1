# Secrets (keep the template)
.env
.env.*
!.env.example

# Python bytecode, caches, builds, and test artefacts
__pycache__/
*.py[cod]
*$py.class
.eggs/
*.egg
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Jupyter notebooks
.ipynb_checkpoints/

# DuckDB write-ahead logs (the .duckdb file itself is a deliverable)
*.duckdb.wal
*.db.wal

# Data files are tracked so the repository matches the Canvas submission.
# The ABS zip is excluded because its extracted shapefile is tracked.
*.zip

# Logs and temporary files
*.log
tmp/
temp/

# OS and editor files
.DS_Store
Thumbs.db
.Rhistory
.idea/
.vscode/
*.swp
*.swo
*~
.cursor/
